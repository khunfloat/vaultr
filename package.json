{
  "name": "vaultr",
  "private": true,
  "version": "0.1.0",
  "description": "Kanban tickets and Obsidian-style notes in a single offline HTML file. Your data stays as Markdown in your own folder.",
  "license": "MIT",
  "author": "Chayoot Kositwanich",
  "homepage": "https://github.com/khunfloat/vaultr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khunfloat/vaultr.git"
  },
  "bugs": {
    "url": "https://github.com/khunfloat/vaultr/issues"
  },
  "keywords": [
    "kanban",
    "notes",
    "markdown",
    "obsidian",
    "local-first",
    "offline",
    "single-file",
    "file-system-access-api"
  ],
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "fractional-indexing": "^4.0.0",
    "lucide-react": "^1.46.0",
    "markdown-it": "^15.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "minisearch": "^7.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
